# ReelToReal Environment Configuration

PORT=5000

# AI Provider: "gemini" for Google AI Studio or "openai" for OpenAI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MongoDB URI (Optional: falls back to in-memory store if unavailable)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/reeltoreal

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FFmpeg Executable Path (Optional: defaults to bundled ffmpeg-static)
FFMPEG_PATH=ffmpeg
