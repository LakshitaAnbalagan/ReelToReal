# Server
PORT=5000

# AI provider: use "gemini" for Google AI Studio or "openai" for OpenAI.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/reeltoreal
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set true to run with local demo records, no external services needed
DEMO_MODE=true
# Optional: full path to ffmpeg executable, if not on PATH
FFMPEG_PATH=ffmpeg
